<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 1;">
        <engine:VisualElement style="flex-grow: 1; height: 370px; justify-content: center; margin-top: 43px; margin-right: 43px; margin-bottom: 43px; margin-left: 43px; padding-top: 29px; padding-right: 29px; padding-bottom: 29px; padding-left: 29px; font-size: 13px; -unity-text-outline-color: rgba(0, 0, 0, 0.24); -unity-text-outline-width: -15px; background-color: rgba(0, 0, 0, 0);">
            <engine:Button text="Start Game&#10;" style="height: 63px; font-size: 32px;" />
            <engine:Button text="Controls" name="Button" style="height: 63px; font-size: 32px;" />
            <engine:Button text="Description" style="height: 63px; font-size: 32px;" />
            <engine:Button text="Exit Game" name="Button" style="height: 63px; font-size: 32px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
